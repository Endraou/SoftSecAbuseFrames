  "query": "\n        SELECT id as \"id!\", owner_id as \"owner_id!\", title as \"title!\", content as \"content!\", locked_by, locked_at\n        FROM notes n\n        LEFT JOIN note_shares s ON n.id = s.note_id\n        WHERE n.id = $1 AND (n.owner_id = $2 OR s.user_id = $2)\n        ",
